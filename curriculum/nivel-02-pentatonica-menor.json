{
  "level": {
    "slug": "nivel-02-pentatonica-menor",
    "position": 2,
    "name": "Pentatónica menor",
    "description": "Tus primeras escalas: la pentatónica menor de La en las cajas 1 y 2, cómo se conectan, un riff y una improvisación sobre la tónica. Es el paso natural después de los power chords.",
    "instrument": "electric"
