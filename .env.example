# Copiá este archivo a .env y completá los valores. .env nunca se commitea.

# URL base de la API (la usan el worker y el Rig)
GUITAR_API_URL=http://localhost:8000

# Token Bearer que exige todo /api/v1 salvo /health
GUITAR_API_TOKEN=cambiame

# Token propio del worker de análisis (distinto del anterior). Solo sirve en /api/v1/jobs;
# el de la UI no sirve ahí y este no sirve en el resto de la API. Vacío: /jobs rechaza todo.
GUITAR_WORKER_TOKEN=cambiame-tambien

# Segundos de lease de un trabajo de análisis antes de que vuelva a la cola (default 300)
# GUITAR_JOB_LEASE_SECONDS=300

# Token que usa la UI en el navegador (el mismo; en Docker lo pasa el compose como build arg)
VITE_GUITAR_API_TOKEN=${GUITAR_API_TOKEN}

# Conexión a Postgres para correr la API fuera de Docker (en Docker la arma el compose)
DATABASE_URL=postgresql+psycopg://guitarra:guitarra@localhost:5432/guitarra

# Docker Compose: credenciales de Postgres y puertos publicados (siempre en 127.0.0.1)
POSTGRES_USER=guitarra
POSTGRES_PASSWORD=guitarra
POSTGRES_DB=guitarra
POSTGRES_PORT=5432
API_PORT=8000

# Carpeta con la UI compilada que sirve la API (por defecto ui/dist; el Dockerfile la fija)
# GUITAR_UI_DIST=

# Carpeta con los curriculum/*.json que carga la API al arrancar (por defecto curriculum/; el Dockerfile la fija)
# GUITAR_CURRICULUM_DIR=

# Worker de análisis (nativo, ver README)
# GUITAR_CACHE_DIR=      # por defecto %USERPROFILE%/GuitarApp/cache
# GUITAR_WORKER_ID=      # por defecto el hostname

# beat_this (tempo y compases). install.ps1 baja los pesos con reintentos; si el host oficial
# está caído usa el espejo safetensors. Por defecto en %USERPROFILE%/GuitarApp/models.
# GUITAR_BEAT_THIS_CHECKPOINT=C:/ruta/beat_this-final0.ckpt
# GUITAR_BEAT_THIS_SHA256=   # SHA-256 esperado del final0.ckpt (ya viene fijado)
# GUITAR_BEAT_THIS_URL=
# GUITAR_BEAT_THIS_MIRROR_URL=

# Opcional: ruta a ffmpeg si no está en el PATH (el worker lo usa para bajar el audio)
# GUITAR_FFMPEG=C:/ruta/a/ffmpeg.exe

# Opcional: links de Spotify en el worker. Se sacan en developer.spotify.com -> Dashboard ->
# Create app -> Settings -> Client ID / Client secret (flujo client credentials).
# Sin esto, un link de Spotify falla con un mensaje claro; YouTube y la búsqueda andan igual.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Cifra Club (acordes publicados, dato opcional): segundos mínimos entre pedidos y URL base
# GUITAR_CIFRACLUB_MIN_INTERVAL_S=3
# GUITAR_CIFRACLUB_BASE_URL=https://www.cifraclub.com
