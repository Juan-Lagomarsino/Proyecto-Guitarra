# Copiá este archivo a .env y completá los valores. .env nunca se commitea.

# URL base de la API (la usan el worker y el Rig)
GUITAR_API_URL=http://localhost:8000

# Token Bearer que exige todo /api/v1 salvo /health
GUITAR_API_TOKEN=cambiame

# Token que usa la UI en el navegador (el mismo; en Docker lo pasa el compose como build arg)
VITE_GUITAR_API_TOKEN=${GUITAR_API_TOKEN}

# Conexión a Postgres para correr la API fuera de Docker (en Docker la arma el compose)
DATABASE_URL=postgresql+psycopg://guitarra:guitarra@localhost:5432/guitarra

# Docker Compose: credenciales de Postgres y puertos publicados (siempre en 127.0.0.1)
POSTGRES_USER=guitarra
POSTGRES_PASSWORD=guitarra
POSTGRES_DB=guitarra
POSTGRES_PORT=5432
API_PORT=8000

# Carpeta con la UI compilada que sirve la API (por defecto ui/dist; el Dockerfile la fija)
# GUITAR_UI_DIST=
